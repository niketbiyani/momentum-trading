# Dhan API Credentials
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# Spike Detection Settings
SPIKE_THRESHOLD_PCT=5.0      # % change in a 10-bar window to qualify as spike
RSI_OVERBOUGHT=70            # RSI level considered overbought
RSI_OVERSOLD=30              # RSI level considered oversold
RSI_UP_MIN=45                # After up-spike: RSI must NOT drop below this
RSI_DOWN_MAX=55              # After down-spike: RSI must NOT rise above this

# Indicator Periods
RSI_PERIOD=14
RSI_EMA_PERIOD=50
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Lookback Table
LOOKBACK_START=10
LOOKBACK_END=150
LOOKBACK_STEP=10

# Nifty Settings
NIFTY_STRIKE_STEP=50         # Strike increments
